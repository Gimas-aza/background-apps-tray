msgid "Application"
msgstr "Приложение"

#, c-format
msgid "%d Background App"
msgid_plural "%d Background Apps"
msgstr[0] "%d фоновое приложение"
msgstr[1] "%d фоновых приложения"
msgstr[2] "%d фоновых приложений"

msgid "No Background Apps"
msgstr "Нет фоновых приложений"

msgid "Tray menu"
msgstr "Меню трея"

msgid "Application menu"
msgstr "Меню приложения"

msgid "Open application"
msgstr "Открыть приложение"

msgid "Open Tray Menu"
msgstr "Открыть меню трея"

msgid "Pin to Top Bar"
msgstr "Закрепить на верхней панели"

msgid "Unpin from Top Bar"
msgstr "Открепить с верхней панели"

msgid "Quit application"
msgstr "Завершить приложение"

