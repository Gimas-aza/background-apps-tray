msgid "Monochrome"
msgstr "Монохромный"

msgid "Choose Icon…"
msgstr "Выбрать значок…"

msgid "Restore Default Icon"
msgstr "Восстановить стандартный значок"

msgid "Images"
msgstr "Изображения"

msgid "Could not open the image file"
msgstr "Не удалось открыть файл изображения"
